{
 "doctype": "Print Format",
 "name": "BBF Token Print",
 "module": "BBF Gate Entry",
 "doc_type": "BBF Token",
 "standard": "No",
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "custom_format": 1,
 "html": "<div style=\"text-align: center; padding: 20px; font-family: Arial, sans-serif;\">\n<h2 style=\"margin-bottom: 5px;\">Betul Bio Fuel Pvt. Ltd.</h2>\n<hr style=\"margin: 10px 0;\" />\n<h1 style=\"font-size: 48px; margin: 15px 0;\">{{ doc.token_number }}</h1>\n{% set barcode_svg = frappe.get_doc('BBF Token', doc.name).as_dict().get('barcode') %}\n{% if barcode_svg %}\n<div style=\"margin: 15px auto; max-width: 300px;\">{{ barcode_svg }}</div>\n{% else %}\n<div style=\"margin: 15px auto; font-size: 36px; font-family: 'Libre Barcode 128', 'Code 128', monospace; letter-spacing: 5px;\">{{ doc.token_number }}</div>\n{% endif %}\n<table style=\"width: 100%; margin: 15px 0; font-size: 18px;\">\n<tr><td style=\"text-align: right; padding: 5px;\"><strong>Date:</strong></td><td style=\"text-align: left; padding: 5px;\">{{ frappe.format(doc.entry_date, {'fieldtype': 'Date'}) }}</td></tr>\n<tr><td style=\"text-align: right; padding: 5px;\"><strong>Time:</strong></td><td style=\"text-align: left; padding: 5px;\">{{ doc.entry_time }}</td></tr>\n<tr><td style=\"text-align: right; padding: 5px;\"><strong>Purpose:</strong></td><td style=\"text-align: left; padding: 5px;\">{{ doc.purpose or '' }}</td></tr>\n<tr><td style=\"text-align: right; padding: 5px;\"><strong>Vehicle:</strong></td><td style=\"text-align: left; padding: 5px;\">{{ doc.vehicle_number or '' }}</td></tr>\n<tr><td style=\"text-align: right; padding: 5px;\"><strong>Driver:</strong></td><td style=\"text-align: left; padding: 5px;\">{{ doc.driver_name or '' }}</td></tr>\n</table>\n<hr style=\"margin: 10px 0;\" />\n<p style=\"font-size: 12px; color: #888;\">Gate Entry Token - Please keep this token safe</p>\n</div>"
}

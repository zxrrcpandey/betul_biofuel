{
 "doctype": "Print Format",
 "name": "BBF Token Print",
 "module": "BBF Gate Entry",
 "doc_type": "BBF Token",
 "standard": "Yes",
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "custom_format": 1,
 "html": "<div style=\"text-align: center; padding: 20px; font-family: Arial, sans-serif;\">\n<h1 style=\"font-size: 48px; margin-bottom: 10px;\">{{ doc.token_number }}</h1>\n<div style=\"margin: 20px auto; max-width: 300px;\">\n<img src=\"{{ frappe.utils.get_url() }}/api/method/frappe.client.get_barcode?barcode_type=Code128&text={{ doc.token_number }}&width=300&height=80\" alt=\"{{ doc.token_number }}\" style=\"width: 100%; height: auto;\" />\n</div>\n<p style=\"font-size: 20px; margin: 5px 0;\"><strong>Date:</strong> {{ frappe.format(doc.entry_date, {'fieldtype': 'Date'}) }}</p>\n<p style=\"font-size: 20px; margin: 5px 0;\"><strong>Time:</strong> {{ doc.entry_time }}</p>\n<hr style=\"margin: 20px 0;\" />\n<p style=\"font-size: 12px; color: #888;\">Betul Bio Fuel Pvt. Ltd.</p>\n</div>"
}

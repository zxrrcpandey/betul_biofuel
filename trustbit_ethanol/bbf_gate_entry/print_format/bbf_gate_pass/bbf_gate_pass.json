{
 "doctype": "Print Format",
 "name": "BBF Gate Pass",
 "module": "BBF Gate Entry",
 "doc_type": "BBF Token",
 "standard": "Yes",
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "custom_format": 1,
 "html": "<style>\n  .gate-pass { font-family: Arial, sans-serif; max-width: 500px; margin: 0 auto; border: 2px solid #333; padding: 0; }\n  .gate-pass table { border-collapse: collapse; }\n  .gp-header { background: #1a237e; color: #fff; text-align: center; padding: 12px; }\n  .gp-header h2 { margin: 0; font-size: 18px; letter-spacing: 1px; }\n  .gp-header h3 { margin: 4px 0 0; font-size: 14px; font-weight: normal; color: #bbdefb; }\n  .gp-pass-no { background: #e8eaf6; text-align: center; padding: 8px; border-bottom: 1px solid #ccc; }\n  .gp-pass-no span { font-size: 24px; font-weight: bold; color: #1a237e; letter-spacing: 2px; }\n  .gp-body { padding: 12px 16px; }\n  .gp-label { font-weight: bold; color: #555; font-size: 13px; padding: 3px 10px 3px 0; vertical-align: top; white-space: nowrap; width: 130px; }\n  .gp-value { color: #222; font-size: 13px; padding: 3px 0; vertical-align: top; }\n  .gp-photo-cell { width: 95px; vertical-align: top; padding-right: 12px; }\n  .gp-photo-box { width: 90px; height: 110px; border: 1px solid #ccc; background: #f5f5f5; text-align: center; overflow: hidden; }\n  .gp-photo-box img { width: 90px; height: 110px; }\n  .gp-photo-placeholder { color: #aaa; font-size: 11px; padding-top: 45px; }\n  .gp-section-title { font-size: 12px; font-weight: bold; color: #1a237e; border-bottom: 1px solid #1a237e; margin: 10px 0 6px; padding-bottom: 2px; text-transform: uppercase; }\n  .gp-barcode { text-align: center; padding: 8px; border-top: 1px dashed #ccc; margin-top: 8px; }\n  .gp-time-cell { text-align: center; padding: 8px 5px; vertical-align: top; }\n  .gp-time-label { font-size: 10px; color: #888; text-transform: uppercase; }\n  .gp-time-value { font-size: 13px; font-weight: bold; margin-top: 2px; }\n  .gp-footer { background: #fff3e0; border-top: 1px solid #ffcc80; padding: 8px 16px; font-size: 11px; color: #e65100; text-align: center; }\n  .gp-sig-cell { text-align: center; padding: 0 10px; vertical-align: bottom; width: 50%; }\n  .gp-sig-line { border-bottom: 1px solid #333; width: 80%; margin: 25px auto 4px; }\n  .gp-sig-label { font-size: 10px; color: #888; }\n</style>\n<div class=\"gate-pass\">\n  <div class=\"gp-header\">\n    <h2>BETUL BIO FUEL PVT. LTD.</h2>\n    <h3>VISITOR GATE PASS</h3>\n  </div>\n  <div class=\"gp-pass-no\">\n    <span>{{ doc.token_number }}</span>\n  </div>\n  <div class=\"gp-body\">\n    <table width=\"100%\">\n      <tr>\n        <td class=\"gp-photo-cell\" rowspan=\"5\">\n          <div class=\"gp-photo-box\">\n            {% if doc.visitor_photo %}\n              <img src=\"{{ doc.visitor_photo }}\" alt=\"Photo\" />\n            {% else %}\n              <div class=\"gp-photo-placeholder\">No Photo</div>\n            {% endif %}\n          </div>\n        </td>\n        <td class=\"gp-label\">Visitor Name:</td>\n        <td class=\"gp-value\">{{ doc.visitor_name or '' }}</td>\n      </tr>\n      <tr>\n        <td class=\"gp-label\">Company:</td>\n        <td class=\"gp-value\">{{ doc.visitor_company or '-' }}</td>\n      </tr>\n      <tr>\n        <td class=\"gp-label\">Contact:</td>\n        <td class=\"gp-value\">{{ doc.contact_number or '-' }}</td>\n      </tr>\n      <tr>\n        <td class=\"gp-label\">ID:</td>\n        <td class=\"gp-value\">{{ doc.id_proof_type or '' }} {{ doc.id_proof_number or '' }}</td>\n      </tr>\n      <tr>\n        <td class=\"gp-label\">No. of Visitors:</td>\n        <td class=\"gp-value\">{{ doc.number_of_visitors or 1 }}</td>\n      </tr>\n    </table>\n    <div class=\"gp-section-title\">Visit Details</div>\n    <table width=\"100%\">\n      <tr><td class=\"gp-label\">Purpose:</td><td class=\"gp-value\">{{ doc.visit_purpose or '' }}</td></tr>\n      {% if doc.purpose_detail %}\n      <tr><td class=\"gp-label\">Detail:</td><td class=\"gp-value\">{{ doc.purpose_detail }}</td></tr>\n      {% endif %}\n      <tr><td class=\"gp-label\">Destination:</td><td class=\"gp-value\">{{ doc.destination or '' }}{% if doc.destination_detail %} ({{ doc.destination_detail }}){% endif %}</td></tr>\n      <tr><td class=\"gp-label\">Host:</td><td class=\"gp-value\">{{ doc.host_name or '-' }}{% if doc.host_department %} ({{ doc.host_department }}){% endif %}</td></tr>\n      <tr><td class=\"gp-label\">Expected Duration:</td><td class=\"gp-value\">{{ doc.expected_duration or '-' }}</td></tr>\n      {% if doc.vehicle_in_gate_pass %}\n      <tr><td class=\"gp-label\">Vehicle:</td><td class=\"gp-value\">{{ doc.vehicle_in_gate_pass }}</td></tr>\n      {% endif %}\n    </table>\n    <table width=\"100%\" style=\"margin-top: 10px; border-top: 1px solid #ccc; padding-top: 5px;\">\n      <tr>\n        <td class=\"gp-time-cell\">\n          <div class=\"gp-time-label\">Date</div>\n          <div class=\"gp-time-value\">{{ frappe.format(doc.entry_date, {'fieldtype': 'Date'}) }}</div>\n        </td>\n        <td class=\"gp-time-cell\">\n          <div class=\"gp-time-label\">Entry Time</div>\n          <div class=\"gp-time-value\">{{ frappe.format(doc.entry_time, {'fieldtype': 'Time'}) if doc.entry_time else '' }}</div>\n        </td>\n        <td class=\"gp-time-cell\">\n          <div class=\"gp-time-label\">Exit Time</div>\n          <div class=\"gp-time-value\">{{ frappe.format(doc.g1_exit_time, {'fieldtype': 'Datetime'}) if doc.g1_exit_time else '____________' }}</div>\n        </td>\n      </tr>\n    </table>\n    <div class=\"gp-barcode\">\n      {% set barcode_svg = frappe.get_doc('BBF Token', doc.name).as_dict().get('barcode') %}\n      {% if barcode_svg %}\n        <div style=\"max-width: 250px; margin: 0 auto;\">{{ barcode_svg }}</div>\n      {% endif %}\n    </div>\n    <table width=\"100%\" style=\"margin-top: 15px; border-top: 1px solid #eee; padding-top: 5px;\">\n      <tr>\n        <td class=\"gp-sig-cell\">\n          <div class=\"gp-sig-line\"></div>\n          <div class=\"gp-sig-label\">G1 Security</div>\n        </td>\n        <td class=\"gp-sig-cell\">\n          <div class=\"gp-sig-line\"></div>\n          <div class=\"gp-sig-label\">Visitor Signature</div>\n        </td>\n      </tr>\n    </table>\n  </div>\n  <div class=\"gp-footer\">\n    &#9888; This pass must be returned at G1 exit. Valid for single entry only. Report to security if lost.\n  </div>\n</div>"
}

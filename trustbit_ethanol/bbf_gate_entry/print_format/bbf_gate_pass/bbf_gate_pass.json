{
 "doctype": "Print Format",
 "name": "BBF Gate Pass",
 "module": "BBF Gate Entry",
 "doc_type": "BBF Token",
 "standard": "Yes",
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "custom_format": 1,
 "html": "<style>\n  .gate-pass { font-family: Arial, sans-serif; max-width: 500px; margin: 0 auto; border: 2px solid #333; padding: 0; }\n  .gp-header { background: #1a237e; color: #fff; text-align: center; padding: 12px; }\n  .gp-header h2 { margin: 0; font-size: 18px; letter-spacing: 1px; }\n  .gp-header h3 { margin: 4px 0 0; font-size: 14px; font-weight: normal; color: #bbdefb; }\n  .gp-pass-no { background: #e8eaf6; text-align: center; padding: 8px; border-bottom: 1px solid #ccc; }\n  .gp-pass-no span { font-size: 24px; font-weight: bold; color: #1a237e; letter-spacing: 2px; }\n  .gp-body { padding: 12px 16px; }\n  .gp-row { display: flex; margin-bottom: 6px; font-size: 13px; }\n  .gp-label { width: 130px; font-weight: bold; color: #555; flex-shrink: 0; }\n  .gp-value { flex: 1; color: #222; }\n  .gp-photo-section { display: flex; align-items: flex-start; margin-bottom: 10px; }\n  .gp-photo { width: 90px; height: 110px; border: 1px solid #ccc; margin-right: 15px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #f5f5f5; overflow: hidden; }\n  .gp-photo img { width: 100%; height: 100%; object-fit: cover; }\n  .gp-photo-placeholder { color: #aaa; font-size: 11px; text-align: center; }\n  .gp-details-right { flex: 1; }\n  .gp-section-title { font-size: 12px; font-weight: bold; color: #1a237e; border-bottom: 1px solid #1a237e; margin: 10px 0 6px; padding-bottom: 2px; text-transform: uppercase; }\n  .gp-barcode { text-align: center; padding: 8px; border-top: 1px dashed #ccc; margin-top: 8px; }\n  .gp-timing { display: flex; margin-top: 8px; border-top: 1px solid #ccc; padding-top: 8px; }\n  .gp-time-box { flex: 1; text-align: center; }\n  .gp-time-label { font-size: 10px; color: #888; text-transform: uppercase; }\n  .gp-time-value { font-size: 13px; font-weight: bold; margin-top: 2px; }\n  .gp-footer { background: #fff3e0; border-top: 1px solid #ffcc80; padding: 8px 16px; font-size: 11px; color: #e65100; text-align: center; }\n  .gp-signature { display: flex; margin-top: 15px; padding-top: 8px; border-top: 1px solid #eee; }\n  .gp-sig-box { flex: 1; text-align: center; }\n  .gp-sig-line { border-bottom: 1px solid #333; width: 80%; margin: 20px auto 4px; }\n  .gp-sig-label { font-size: 10px; color: #888; }\n</style>\n<div class=\"gate-pass\">\n  <div class=\"gp-header\">\n    <h2>BETUL BIO FUEL PVT. LTD.</h2>\n    <h3>VISITOR GATE PASS</h3>\n  </div>\n  <div class=\"gp-pass-no\">\n    <span>{{ doc.token_number }}</span>\n  </div>\n  <div class=\"gp-body\">\n    <div class=\"gp-photo-section\">\n      <div class=\"gp-photo\">\n        {% if doc.visitor_photo %}\n          <img src=\"{{ doc.visitor_photo }}\" alt=\"Visitor Photo\" />\n        {% else %}\n          <div class=\"gp-photo-placeholder\">No Photo</div>\n        {% endif %}\n      </div>\n      <div class=\"gp-details-right\">\n        <div class=\"gp-row\"><div class=\"gp-label\">Visitor Name:</div><div class=\"gp-value\">{{ doc.visitor_name or '' }}</div></div>\n        <div class=\"gp-row\"><div class=\"gp-label\">Company:</div><div class=\"gp-value\">{{ doc.visitor_company or '-' }}</div></div>\n        <div class=\"gp-row\"><div class=\"gp-label\">Contact:</div><div class=\"gp-value\">{{ doc.contact_number or '-' }}</div></div>\n        <div class=\"gp-row\"><div class=\"gp-label\">ID:</div><div class=\"gp-value\">{{ doc.id_proof_type or '' }} {{ doc.id_proof_number or '' }}</div></div>\n        <div class=\"gp-row\"><div class=\"gp-label\">No. of Visitors:</div><div class=\"gp-value\">{{ doc.number_of_visitors or 1 }}</div></div>\n      </div>\n    </div>\n    <div class=\"gp-section-title\">Visit Details</div>\n    <div class=\"gp-row\"><div class=\"gp-label\">Purpose:</div><div class=\"gp-value\">{{ doc.visit_purpose or '' }}</div></div>\n    {% if doc.purpose_detail %}\n    <div class=\"gp-row\"><div class=\"gp-label\">Detail:</div><div class=\"gp-value\">{{ doc.purpose_detail }}</div></div>\n    {% endif %}\n    <div class=\"gp-row\"><div class=\"gp-label\">Destination:</div><div class=\"gp-value\">{{ doc.destination or '' }}{% if doc.destination_detail %} ({{ doc.destination_detail }}){% endif %}</div></div>\n    <div class=\"gp-row\"><div class=\"gp-label\">Host:</div><div class=\"gp-value\">{{ doc.host_name or '-' }}{% if doc.host_department %} ({{ doc.host_department }}){% endif %}</div></div>\n    <div class=\"gp-row\"><div class=\"gp-label\">Expected Duration:</div><div class=\"gp-value\">{{ doc.expected_duration or '-' }}</div></div>\n    {% if doc.vehicle_in_gate_pass %}\n    <div class=\"gp-row\"><div class=\"gp-label\">Vehicle:</div><div class=\"gp-value\">{{ doc.vehicle_in_gate_pass }}</div></div>\n    {% endif %}\n    <div class=\"gp-timing\">\n      <div class=\"gp-time-box\">\n        <div class=\"gp-time-label\">Date</div>\n        <div class=\"gp-time-value\">{{ frappe.format(doc.entry_date, {'fieldtype': 'Date'}) }}</div>\n      </div>\n      <div class=\"gp-time-box\">\n        <div class=\"gp-time-label\">Entry Time</div>\n        <div class=\"gp-time-value\">{{ doc.entry_time or '' }}</div>\n      </div>\n      <div class=\"gp-time-box\">\n        <div class=\"gp-time-label\">Exit Time</div>\n        <div class=\"gp-time-value\">{{ frappe.format(doc.g1_exit_time, {'fieldtype': 'Datetime'}) if doc.g1_exit_time else '____________' }}</div>\n      </div>\n    </div>\n    <div class=\"gp-barcode\">\n      {% set barcode_svg = frappe.get_doc('BBF Token', doc.name).as_dict().get('barcode') %}\n      {% if barcode_svg %}\n        <div style=\"max-width: 250px; margin: 0 auto;\">{{ barcode_svg }}</div>\n      {% endif %}\n    </div>\n    <div class=\"gp-signature\">\n      <div class=\"gp-sig-box\">\n        <div class=\"gp-sig-line\"></div>\n        <div class=\"gp-sig-label\">G1 Security</div>\n      </div>\n      <div class=\"gp-sig-box\">\n        <div class=\"gp-sig-line\"></div>\n        <div class=\"gp-sig-label\">Visitor Signature</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"gp-footer\">\n    &#9888; This pass must be returned at G1 exit. Valid for single entry only. Report to security if lost.\n  </div>\n</div>"
}

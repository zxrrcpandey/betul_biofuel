{
 "doctype": "Print Format",
 "name": "BBPL RGP Challan",
 "module": "TS Gate Entry",
 "doc_type": "TS Returnable Gate Pass",
 "standard": "No",
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "custom_format": 1,
 "creation": "2026-08-28 00:00:00",
 "modified": "2026-08-28 00:00:02",
 "html": "<style>\n@page { size: A4; margin: 6mm 8mm 6mm 8mm; }\nbody { font-family: Arial, sans-serif; font-size: 10px; color: #000; }\n.rgp-copy { position: relative; }\n.rgp-watermark { position: absolute; top: 35%; left: 8%; font-size: 110px; color: rgba(255,0,0,0.08); font-weight: bold; transform: rotate(-30deg); -webkit-transform: rotate(-30deg); z-index: 0; letter-spacing: 18px; }\n.rgp-copybar { width: 100%; border-collapse: collapse; margin: 0 0 4px 0; }\n.rgp-copybar td { border: 1px solid #000; background: #eee; text-align: center; font-size: 11px; font-weight: bold; letter-spacing: 1px; padding: 3px 6px; }\n.rgp-header-table { width: 100%; border-collapse: collapse; }\n.rgp-header-table td { border: none; padding: 0; vertical-align: middle; }\n.rgp-logo-cell { width: 110px; padding-left: 6px; }\n.rgp-logo-cell img { max-width: 95px; max-height: 75px; }\n.rgp-head-center { text-align: center; }\n.rgp-cname { font-size: 18px; font-weight: bold; letter-spacing: 0.5px; line-height: 1.2; }\n.rgp-caddr { font-size: 12px; font-weight: bold; text-decoration: underline; margin-top: 2px; }\n.rgp-cgst { font-size: 10px; margin-top: 2px; }\n.rgp-head-right { width: 210px; text-align: right; font-size: 10px; vertical-align: top; }\n.rgp-challan-no { font-size: 14px; font-weight: bold; }\n.rgp-header-rule { border-bottom: 2px solid #000; margin: 4px 0 6px 0; height: 0; line-height: 0; }\n.rgp-title-block { text-align: center; margin: 4px 0; }\n.rgp-title { font-size: 15px; font-weight: bold; text-decoration: underline; letter-spacing: 1px; }\n.rgp-subtitle { font-size: 10px; margin-top: 2px; }\n.rgp-parties { width: 100%; border-collapse: collapse; margin: 4px 0; }\n.rgp-parties th { border: 1px solid #000; background: #eee; font-size: 10px; font-weight: bold; padding: 3px 6px; text-align: left; width: 50%; }\n.rgp-parties td { border: 1px solid #000; font-size: 11px; padding: 4px 6px; vertical-align: top; width: 50%; }\n.rgp-addr { white-space: pre-line; }\n.rgp-purpose { width: 100%; border-collapse: collapse; margin: 4px 0; }\n.rgp-purpose td { border: 1px solid #f1c40f; background: #fff8e1; text-align: center; padding: 4px 6px; }\n.rgp-purpose .p1 { font-size: 11px; font-weight: bold; font-style: italic; }\n.rgp-purpose .p2 { font-size: 10px; margin-top: 2px; }\n.rgp-return { width: 100%; border-collapse: collapse; margin: 4px 0; }\n.rgp-return td { border: 1px solid #000; background: #e8eaf6; text-align: center; padding: 4px 6px; }\n.rgp-return .r1 { font-size: 13px; font-weight: bold; }\n.rgp-return .r2 { font-size: 10px; margin-top: 2px; }\n.rgp-items { width: 100%; border-collapse: collapse; margin: 4px 0; }\n.rgp-items th { background: #e8e8e8; border: 1px solid #000; padding: 3px 6px; font-size: 10px; font-weight: bold; text-align: center; }\n.rgp-items td { border: 1px solid #000; padding: 3px 6px; font-size: 11px; vertical-align: top; }\n.rgp-items .num { text-align: right; white-space: nowrap; }\n.rgp-items .ctr { text-align: center; }\n.rgp-items .desc-sub { font-size: 10px; margin-top: 2px; }\n.rgp-items .serial-sub { font-size: 9px; margin-top: 2px; }\n.rgp-items tfoot td { border: 1px solid #000; padding: 4px 6px; }\n.rgp-items tfoot .total-lbl { text-align: right; background: #eee; font-weight: bold; }\n.rgp-items tfoot .total-val { background: #cce6ff; font-size: 12px; font-weight: bold; text-align: right; white-space: nowrap; }\n.rgp-items tfoot .words { font-size: 10px; text-align: left; }\n.rgp-transport { width: 100%; border-collapse: collapse; margin: 4px 0; }\n.rgp-transport td { border: 1px solid #000; font-size: 10px; padding: 3px 6px; }\n.rgp-transport .lbl { background: #eee; font-weight: bold; width: 11%; }\n.rgp-transport .note { font-size: 9px; font-style: italic; }\n.rgp-declaration { font-size: 9px; font-style: italic; margin: 4px 0; line-height: 1.4; }\n.rgp-signs { width: 100%; border-collapse: collapse; margin: 6px 0 4px 0; }\n.rgp-signs td { border: 1px solid #000; width: 20%; height: 60px; text-align: center; vertical-align: bottom; padding: 3px; }\n.rgp-sign-rule { border-bottom: 1px solid #333; width: 80%; margin: 28px auto 4px auto; height: 0; }\n.rgp-sign-cap { font-size: 9px; color: #555; }\n.rgp-sign-sub { font-size: 8px; color: #888; }\n.rgp-footer { border-top: 1px solid #000; margin-top: 6px; padding-top: 4px; text-align: center; font-size: 10px; }\n.rgp-footer .fname { font-size: 11px; font-weight: bold; }\n</style>\n\n{% for copy_label in ['ORIGINAL FOR CONSIGNEE', 'DUPLICATE FOR TRANSPORTER', 'TRIPLICATE FOR CONSIGNOR'] %}\n<div class=\"rgp-copy\">\n\n{% if doc.docstatus == 0 %}<div class=\"rgp-watermark\">DRAFT</div>{% endif %}\n\n<table class=\"rgp-copybar\"><tr><td>{{ copy_label }}</td></tr></table>\n\n<table class=\"rgp-header-table\">\n<tr>\n  <td class=\"rgp-logo-cell\"><img src=\"/files/client_logo.png\" alt=\"BBPL\" onerror=\"this.style.display='none'\"></td>\n  <td class=\"rgp-head-center\">\n    <div class=\"rgp-cname\">BETUL BIOFUEL PVT LTD</div>\n    <div class=\"rgp-caddr\">Bodi Junawani, Betul (M.P.)</div>\n    <div class=\"rgp-cgst\">GSTIN: 23AAJCB8781D1ZM</div>\n  </td>\n  <td class=\"rgp-head-right\">\n    <div class=\"rgp-challan-no\">Challan No: {{ doc.name }}</div>\n    <div>Challan Date: {{ frappe.utils.formatdate(doc.challan_date, 'dd-MM-yyyy') }}</div>\n    <div>Vehicle No: {{ (doc.vehicle_number or '________') | e }}</div>\n  </td>\n</tr>\n</table>\n<div class=\"rgp-header-rule\"></div>\n\n<div class=\"rgp-title-block\">\n  <div class=\"rgp-title\">RETURNABLE GATE PASS</div>\n  <div class=\"rgp-subtitle\">Delivery Challan under Rule 55 of the CGST Rules, 2017</div>\n</div>\n\n<table class=\"rgp-parties\">\n<tr><th>CONSIGNOR (FROM)</th><th>CONSIGNEE (TO)</th></tr>\n<tr>\n  <td>\n    <b>BETUL BIOFUEL PVT LTD</b><br>\n    Bodi Junawani, Betul (M.P.)<br>\n    GSTIN: 23AAJCB8781D1ZM<br>\n    State: Madhya Pradesh, Code: 23\n  </td>\n  <td>\n    <b>{{ (doc.supplier_name or '') | e }}</b>\n    <div class=\"rgp-addr\">{{ (doc.supplier_address_display or '') | replace('<br/>', '\\n') | replace('<br>', '\\n') | e }}</div>\n    GSTIN: {{ (doc.supplier_gstin or '_________') | e }}\n  </td>\n</tr>\n</table>\n\n<table class=\"rgp-purpose\"><tr><td>\n  <div class=\"p1\">Goods sent for repair &amp; return &mdash; NOT FOR SALE. Not a supply; tax not payable on this challan.</div>\n  <div class=\"p2\">Purpose: {{ (doc.reason or '') | e }} &middot; Ref. Indent: {{ (doc.material_request or '') | e }} &middot; Cost Centre: {{ (doc.cost_center or '') | e }}</div>\n</td></tr></table>\n\n<table class=\"rgp-return\"><tr><td>\n  <div class=\"r1\">EXPECTED RETURN ON: {{ frappe.utils.formatdate(doc.expected_return_date, 'dd-MM-yyyy') }}</div>\n  <div class=\"r2\">{% if doc.sec143_due_date %}Goods must return within {{ 'three years' if doc.goods_type == 'Capital Goods' else 'one year' }} of this challan date (GST Sec. 143). Limit: {{ frappe.utils.formatdate(doc.sec143_due_date, 'dd-MM-yyyy') }}.{% else %}Moulds/dies/jigs/fixtures/tools &mdash; exempt from the Sec. 143 return limit.{% endif %}</div>\n</td></tr></table>\n\n<table class=\"rgp-items\">\n<thead>\n<tr>\n  <th style=\"width:30px\">Sl.</th>\n  <th>Item &amp; Description</th>\n  <th style=\"width:70px\">HSN</th>\n  <th style=\"width:60px\">Qty</th>\n  <th style=\"width:45px\">UOM</th>\n  <th style=\"width:80px\">Rate</th>\n  <th style=\"width:100px\">Taxable Value</th>\n</tr>\n</thead>\n<tbody>\n{% for item in doc.items %}\n<tr>\n  <td class=\"ctr\">{{ loop.index }}</td>\n  <td><b>{{ (item.item_name or item.item_code or '') | e }}</b>{% if item.description %}<div class=\"desc-sub\">{{ item.description | e }}</div>{% endif %}{% if item.serial_no_out %}<div class=\"serial-sub\">Serial: {{ item.serial_no_out | e }}</div>{% endif %}</td>\n  <td class=\"ctr\">{{ (item.gst_hsn_code or '') | e }}</td>\n  <td class=\"num\">{{ frappe.format(item.qty_out, {'fieldtype': 'Float', 'precision': 2}) }}</td>\n  <td class=\"ctr\">{{ (item.uom or '') | e }}</td>\n  <td class=\"num\">{{ frappe.format(item.rate, {'fieldtype': 'Currency'}) }}</td>\n  <td class=\"num\">{{ frappe.format(item.amount, {'fieldtype': 'Currency'}) }}</td>\n</tr>\n{% endfor %}\n</tbody>\n<tfoot>\n<tr>\n  <td colspan=\"6\" class=\"total-lbl\">Total</td>\n  <td class=\"total-val\">{{ frappe.format(doc.total_taxable_value, {'fieldtype': 'Currency'}) }}</td>\n</tr>\n<tr>\n  <td colspan=\"7\" class=\"words\">Total value in words: {{ frappe.utils.money_in_words(doc.total_taxable_value or 0) }}</td>\n</tr>\n</tfoot>\n</table>\n\n<table class=\"rgp-transport\">\n<tr>\n  <td class=\"lbl\">Transporter</td><td>{{ (doc.transporter or '') | e }}</td>\n  <td class=\"lbl\">Vehicle</td><td>{{ (doc.vehicle_number or '') | e }}</td>\n  <td class=\"lbl\">Driver</td><td>{{ (doc.driver_name or '') | e }}</td>\n  <td class=\"lbl\">LR No</td><td>{{ (doc.lr_number or '') | e }}</td>\n</tr>\n<tr>\n  <td class=\"lbl\">E-Way Bill No</td><td>{% if doc.eway_bill_no %}{{ doc.eway_bill_no | e }}{% else %}&mdash;{% endif %}</td>\n  <td class=\"lbl\">E-Way Date</td><td>{{ frappe.utils.formatdate(doc.eway_bill_date, 'dd-MM-yyyy') if doc.eway_bill_date else '&mdash;' }}</td>\n  <td class=\"lbl\">Inter-State</td><td>{{ 'Yes' if doc.is_interstate else 'No' }}</td>\n  <td colspan=\"2\">{% if not doc.eway_bill_required %}<span class=\"note\">E-way bill not required (value below threshold, intra-state).</span>{% endif %}</td>\n</tr>\n</table>\n\n<div class=\"rgp-declaration\">\nWe declare that the goods described above are sent for repair/servicing and will be returned.<br>\nThe particulars given above are true and correct.\n</div>\n\n<table class=\"rgp-signs\">\n<tr>\n  <td>\n    <div class=\"rgp-sign-rule\"></div>\n    <div class=\"rgp-sign-cap\">Prepared By (Stores)</div>\n    <div class=\"rgp-sign-sub\">Name &amp; Date</div>\n  </td>\n  <td>\n    <div class=\"rgp-sign-rule\"></div>\n    <div class=\"rgp-sign-cap\">Store In-charge</div>\n    <div class=\"rgp-sign-sub\">Name &amp; Date</div>\n  </td>\n  <td>\n    <div class=\"rgp-sign-rule\"></div>\n    <div class=\"rgp-sign-cap\">Security &mdash; G2</div>\n    <div class=\"rgp-sign-sub\">Name &amp; Date</div>\n  </td>\n  <td>\n    <div class=\"rgp-sign-rule\"></div>\n    <div class=\"rgp-sign-cap\">Security &mdash; G1</div>\n    <div class=\"rgp-sign-sub\">Name &amp; Date</div>\n  </td>\n  <td>\n    <div class=\"rgp-sign-rule\"></div>\n    <div class=\"rgp-sign-cap\">Receiver (Vendor)</div>\n    <div class=\"rgp-sign-sub\">Name &amp; Date</div>\n  </td>\n</tr>\n</table>\n\n<div class=\"rgp-footer\">\n  <div class=\"fname\">BETUL BIOFUEL PVT LTD</div>\n  <div>Bodi Junawani, Betul (M.P.)</div>\n  <div>GSTIN: 23AAJCB8781D1ZM</div>\n</div>\n\n</div>\n{% if not loop.last %}<div style=\"page-break-after: always;\"></div>{% endif %}\n{% endfor %}\n"
}
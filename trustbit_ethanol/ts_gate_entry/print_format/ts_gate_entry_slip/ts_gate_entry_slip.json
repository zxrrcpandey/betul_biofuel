{
 "name": "TS Gate Entry Slip",
 "doctype": "Print Format",
 "doc_type": "TS Gate Entry",
 "module": "TS Gate Entry",
 "print_format_type": "Jinja",
 "custom_format": 1,
 "standard": "No",
 "html": "<style>\n.ge-slip { font-family: Arial, sans-serif; max-width: 500px; margin: 0 auto; padding: 10px; }\n.ge-slip .header { background: #1a3a5c; color: #fff; padding: 10px 15px; text-align: center; border-radius: 6px 6px 0 0; }\n.ge-slip .header h2 { margin: 0; font-size: 16px; letter-spacing: 1px; }\n.ge-slip .header p { margin: 2px 0 0; font-size: 10px; opacity: 0.8; }\n.ge-slip .token-box { background: #f0f4f8; padding: 10px; text-align: center; border: 1px solid #ddd; border-top: 0; }\n.ge-slip .token-box h3 { margin: 0; color: #e74c3c; font-size: 20px; font-weight: bold; }\n.ge-slip .token-box .ge-name { font-size: 11px; color: #666; margin-top: 3px; }\n.ge-slip .body { border: 1px solid #ddd; border-top: 0; padding: 12px 15px; }\n.ge-slip table.info { width: 100%; border-collapse: collapse; }\n.ge-slip table.info td { padding: 5px 8px; font-size: 13px; vertical-align: top; }\n.ge-slip table.info td.label { font-weight: bold; color: #555; width: 40%; }\n.ge-slip table.info td.value { color: #222; }\n.ge-slip .remark-box { margin-top: 10px; padding: 8px; background: #f9f9f9; border: 1px solid #eee; border-radius: 4px; min-height: 30px; font-size: 12px; }\n.ge-slip .remark-label { font-weight: bold; font-size: 11px; color: #555; margin-bottom: 3px; }\n.ge-slip .footer-note { text-align: center; margin-top: 12px; padding: 6px; background: #fff8e1; border: 1px dashed #f0ad4e; border-radius: 4px; font-size: 10px; color: #8a6d3b; }\n</style>\n<div class=\"ge-slip\">\n<div class=\"header\">\n<h2>BETUL BIO FUEL PVT. LTD.</h2>\n<p>GATE ENTRY SLIP</p>\n</div>\n<div class=\"token-box\">\n<h3>{{ doc.token_number or '' }}</h3>\n<div class=\"ge-name\">{{ doc.name }}</div>\n</div>\n<div class=\"body\">\n<table class=\"info\">\n<tr><td class=\"label\">Entry Date:</td><td class=\"value\">{{ frappe.format(doc.entry_date, {'fieldtype': 'Date'}) if doc.entry_date else '' }}</td></tr>\n<tr><td class=\"label\">Entry Time:</td><td class=\"value\">{{ frappe.format(doc.entry_time, {'fieldtype': 'Time'}) if doc.entry_time else '' }}</td></tr>\n<tr><td class=\"label\">Material:</td><td class=\"value\">{{ doc.material_flow or '' }}</td></tr>\n<tr><td class=\"label\">Route To:</td><td class=\"value\">{{ doc.route_to or '' }}</td></tr>\n</table>\n<div class=\"remark-label\">Remarks:</div>\n<div class=\"remark-box\">{% set token = frappe.get_doc('TS Token', doc.token_number) if doc.token_number else None %}{{ token.remarks if token and token.remarks else '—' }}</div>\n</div>\n<div class=\"footer-note\">⚠ Keep this slip with the vehicle. Return at exit.</div>\n</div>"
}
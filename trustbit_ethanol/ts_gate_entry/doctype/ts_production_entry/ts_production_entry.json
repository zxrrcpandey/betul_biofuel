 "fields": [
  {
   "fieldname": "production_section",
   "fieldtype": "Section Break",
   "label": "Production Details"
  },
  {
   "default": "PROD-.YYYY.-",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "hidden": 1,
   "label": "Naming Series",
   "no_copy": 1,
   "options": "PROD-.YYYY.-",
   "print_hide": 1
  },
  {
   "bold": 1,
   "description": "The Standard BOM. Defines expected materials + by-products (scrap items) per produced quantity.",
   "fieldname": "bom",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Standard BOM",
   "options": "BOM",
   "reqd": 1
  },
  {
   "fetch_from": "bom.item",
   "fieldname": "production_item",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Finished Item",
   "options": "Item",
   "read_only": 1
  },
  {
   "fetch_from": "bom.item_name",
   "fieldname": "production_item_name",
   "fieldtype": "Data",
   "label": "Finished Item Name",
   "read_only": 1
  },
  {
   "fetch_from": "bom.company",
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "Today",
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Posting Date",
   "reqd": 1
  },
  {
   "fieldname": "shift",
   "fieldtype": "Data",
   "label": "Shift"
  },
  {
   "fieldname": "batch_ref",
   "fieldtype": "Data",
   "label": "Batch / Lot Ref"
  },
  {
   "description": "Auto-created on Submit for Release (drives the raw-material transfer + Job Cards + Manufacture SE). Populated by the release flow — leave blank on a new draft.",
   "fieldname": "work_order",
   "fieldtype": "Link",
   "label": "Work Order",
   "no_copy": 1,
   "options": "Work Order",
   "read_only": 1
  },
  {
   "fieldname": "qty_section",
   "fieldtype": "Section Break",
   "label": "Standard vs Actual — Output"
  },
  {
   "default": "1",
   "description": "How many standard BOM batches this run represents. Standard qty = BOM qty × batches. Use >1 to run a multiple of the BOM batch without a false produced-variance.",
   "fieldname": "standard_batches",
   "fieldtype": "Float",
   "label": "Standard Batches (× BOM qty)"
  },
  {
   "description": "BOM quantity × Standard Batches (the standard output target for this run). Read-only.",
   "fieldname": "standard_qty",
   "fieldtype": "Float",
   "label": "Standard Produced Qty",
   "read_only": 1
  },
  {
   "bold": 1,
   "description": "Actual quantity of finished product produced in this run.",
   "fieldname": "actual_produced_qty",
   "fieldtype": "Float",
   "in_list_view": 1,
   "label": "Actual Produced Qty",
   "reqd": 1
  },
  {
   "fetch_from": "bom.uom",
   "fieldname": "production_uom",
   "fieldtype": "Data",
   "label": "UOM",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "description": "Max material consumption variance across all materials (actual vs BOM standard).",
   "fieldname": "material_variance_pct",
   "fieldtype": "Percent",
   "in_list_view": 1,
   "label": "Material Variance %",
   "read_only": 1
  },
  {
   "description": "Produced qty variance (actual vs standard, scaled to materials consumed).",
   "fieldname": "produced_variance_pct",
   "fieldtype": "Percent",
   "in_list_view": 1,
   "label": "Produced Variance %",
   "read_only": 1
  },
  {
   "description": "Set when material OR produced variance exceeds the tolerance in TS Settings. Informational only in the release flow (the single gate is the Store-Manager raw-material release; there is no CEO gate).",
   "fieldname": "variance_breach",
   "fieldtype": "Check",
   "label": "Variance Breach",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.material_coverage_warning",
   "description": "Warns if a material defined on the BOM is missing from this entry (it would not be consumed).",
   "fieldname": "material_coverage_warning",
   "fieldtype": "Small Text",
   "label": "BOM Coverage Warning",
   "read_only": 1
  },
  {
   "fieldname": "status_section",
   "fieldtype": "Section Break",
   "label": "Status & Approval"
  },
  {
   "bold": 1,
   "default": "Draft",
   "fieldname": "ts_variance_status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "no_copy": 1,
   "options": "Draft\nPending Stores Release\nReleased\nCompleted\nRejected\nCancelled",
   "read_only": 1
  },
  {
   "description": "The native Manufacture Stock Entry (consumes WIP per the BOM recipe, produces finished good + by-products). Created on Store-Manager release.",
   "fieldname": "linked_stock_entry",
   "fieldtype": "Link",
   "label": "Manufacture Stock Entry",
   "no_copy": 1,
   "options": "Stock Entry",
   "read_only": 1
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "submitted_by",
   "fieldtype": "Link",
   "label": "Submitted By",
   "no_copy": 1,
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "posted_by",
   "fieldtype": "Link",
   "label": "Posted / Approved By",
   "no_copy": 1,
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "rejected_by",
   "fieldtype": "Link",
   "label": "Rejected By",
   "no_copy": 1,
   "options": "User",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.ts_variance_status=='Rejected'",
   "fieldname": "rejection_reason",
   "fieldtype": "Small Text",
   "label": "Rejection Reason",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "actual_produced_qty_at_submission",
   "fieldtype": "Float",
   "hidden": 1,
   "label": "Actual Produced Qty (at submission)",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "release_section",
   "fieldtype": "Section Break",
   "label": "Raw-Material Release"
  },
  {
   "description": "The Material-Transfer-for-Manufacture Stock Entry (Stores → WIP) the Store Manager releases. Created as a DRAFT on Submit for Release; submitted on Approve.",
   "fieldname": "release_stock_entry",
   "fieldtype": "Link",
   "label": "Release Stock Entry",
   "no_copy": 1,
   "options": "Stock Entry",
   "read_only": 1
  },
  {
   "fieldname": "released_by",
   "fieldtype": "Link",
   "label": "Released By (Store Manager)",
   "no_copy": 1,
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "released_at",
   "fieldtype": "Datetime",
   "label": "Released At",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "column_break_release",
   "fieldtype": "Column Break"
  },
  {
   "description": "Captured from the BOM at draft. 1 = this BOM has operations (Job Cards are auto-completed during release).",
   "fieldname": "bom_with_operations",
   "fieldtype": "Check",
   "label": "BOM Has Operations",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "description": "Captured from the BOM at draft. Drives whether the raw-material transfer is done at Work-Order level or per Job Card.",
   "fieldname": "bom_transfer_material_against",
   "fieldtype": "Data",
   "label": "Transfer Material Against",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "wip_recon_section",
   "fieldtype": "Section Break",
   "label": "WIP Reconciliation (Released vs Consumed)"
  },
  {
   "description": "Total raw-material value the Store Manager released to WIP (drives what physically moves Stores → WIP).",
   "fieldname": "wip_released_qty",
   "fieldtype": "Float",
   "label": "Released Value (to WIP)",
   "no_copy": 1,
   "precision": "2",
   "read_only": 1
  },
  {
   "description": "Total raw-material value consumed by the Manufacture Stock Entry (BOM recipe scaled to produced qty).",
   "fieldname": "wip_consumed_qty",
   "fieldtype": "Float",
   "label": "Consumed Value (from WIP)",
   "no_copy": 1,
   "precision": "2",
   "read_only": 1
  },
  {
   "fieldname": "column_break_wip",
   "fieldtype": "Column Break"
  },
  {
   "description": "(released − consumed) / consumed × 100. Positive = surplus released to WIP (auto-returned to Stores when enabled).",
   "fieldname": "wip_reconcile_variance_pct",
   "fieldtype": "Float",
   "label": "WIP Reconcile Variance %",
   "no_copy": 1,
   "precision": "2",
   "read_only": 1
  },
  {
   "description": "The auto-return Material-Transfer Stock Entry (WIP → Stores) that zeroed the surplus released raw material, if any.",
   "fieldname": "wip_returned_stock_entry",
   "fieldtype": "Link",
   "label": "Surplus Return Stock Entry",
   "no_copy": 1,
   "options": "Stock Entry",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.wip_reconcile_note",
   "description": "Human summary of leftover / short WIP after the Manufacture Stock Entry.",
   "fieldname": "wip_reconcile_note",
   "fieldtype": "Small Text",
   "label": "WIP Reconciliation Note",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "materials_section",
   "fieldtype": "Section Break",
   "label": "Materials Consumed (Standard vs Actual)"
  },
  {
   "fieldname": "materials",
   "fieldtype": "Table",
   "label": "Materials",
   "options": "TS Production Material"
  },
  {
   "fieldname": "byproducts_section",
   "fieldtype": "Section Break",
   "label": "By-Products (Standard vs Actual)"
  },
  {
   "description": "Auto-filled from the BOM's Scrap Items. Data-driven — works for Ethanol and any other BOM.",
   "fieldname": "byproducts",
   "fieldtype": "Table",
   "label": "By-Products",
   "options": "TS Production By-Product"
  }
